{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/identity/http/shared/v1/identity-operational-options-v1.schema.json",
  "title": "identity-operational-options-v1",
  "$defs": {
    "OperationalOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "branch_name",
        "branch_version",
        "pos_id",
        "pos_name",
        "pos_version"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "branch_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "branch_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pos_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pos_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pos_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "OperationalOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "items",
        "next_cursor"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OperationalOption"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HttpOperationalOption": {
      "type": "object",
      "required": [
        "branch_id",
        "branch_name",
        "branch_version",
        "pos_id",
        "pos_name",
        "pos_version"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "branch_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "branch_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pos_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pos_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pos_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "HttpOperationalOptions": {
      "type": "object",
      "required": [
        "organization_id",
        "items",
        "next_cursor"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/HttpOperationalOption"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
