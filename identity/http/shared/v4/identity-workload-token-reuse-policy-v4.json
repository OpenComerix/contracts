{
  "policy_version": 4,
  "status": "candidate",
  "owner": "identity-tenancy",
  "runtime_demonstrated": false,
  "production_enabled": false,
  "contract": "identity/http/private/v4/identity-internal-auth-v4.yaml",
  "supersedes": "identity/http/private/v3/identity-internal-auth-v3.yaml",
  "profiles": [
    {
      "client_id": "inventory.sales-process-authority",
      "caller": "inventory",
      "audience": "sales-pos.process-authority"
    },
    {
      "client_id": "sales-pos.inventory-results",
      "caller": "sales-pos",
      "audience": "inventory.process-results"
    },
    {
      "client_id": "sales-pos.sales-authority",
      "caller": "sales-pos",
      "audience": "identity-tenancy.sales-authority"
    },
    {
      "client_id": "sales-pos.catalog-capture",
      "caller": "sales-pos",
      "audience": "catalog-pricing.sale-capture"
    },
    {
      "client_id": "catalog-pricing.sales-capture-authority",
      "caller": "catalog-pricing",
      "audience": "sales-pos.catalog-capture-authority"
    },
    {
      "client_id": "sales-pos.inventory-context",
      "caller": "sales-pos",
      "audience": "inventory.sale-context"
    },
    {
      "client_id": "sales-pos.finance-context",
      "caller": "sales-pos",
      "audience": "finance.sale-context"
    },
    {
      "client_id": "inventory.sales-context-authority",
      "caller": "inventory",
      "audience": "sales-pos.context-check-authority"
    },
    {
      "client_id": "finance.sales-context-authority",
      "caller": "finance",
      "audience": "sales-pos.context-check-authority"
    }
  ],
  "storage": {
    "location": "private_process_ram",
    "entries_per_profile_generation": 1,
    "acquisitions_in_flight_per_profile_generation": 1,
    "http_cache": false,
    "persistence": false,
    "logs_or_events": false,
    "tenant_or_session_keyed": false
  },
  "lifetime": {
    "maximum_seconds": 300,
    "reuse_min_remaining_ms_exclusive": 2000,
    "expires_in_anchor": "before_request",
    "effective_expiry": "earliest_verified_exp_wall_and_monotonic_expires_in",
    "sliding_expiry": false,
    "short_token": "use_once_with_remaining_budget",
    "clock_rollback": "discard"
  },
  "acquisition": {
    "trigger": "on_demand",
    "proactive_refresh": false,
    "shared_per_profile_generation": true,
    "waiter_deadlines": "independent",
    "shared_deadline": "fixed_never_extended_by_followers",
    "waiter_cancel": "does_not_cancel_others",
    "late_retired_generation": "discard",
    "restart": "empty"
  },
  "authorization": {
    "verify_credential_each_use": true,
    "verify_at_receiver": true,
    "cache_human_authority": false,
    "cache_step_authority": false,
    "step_authority": "fresh_per_attempt",
    "inventory_authority_http_timeout_ms": 1000,
    "sales_result_total_budget_ms": 2000
  },
  "retirement": {
    "secret_removal": "blocks_new_issuance_only",
    "maximum_issued_token_seconds": 300,
    "existing_token": "may_remain_usable_until_effective_expiry_subject_to_receiver_keys",
    "key_retirement": "receiver_policy_unchanged",
    "jwks_freshness": "existing_inventory_max_30_seconds_less_age_not_a_universal_revocation_guarantee",
    "reconfiguration": "discard_local_entry_and_in_flight_generation"
  },
  "errors": {
    "expired_fallback": false,
    "automatic_operation_retry": false,
    "authentication_rejection": "discard_and_propagate",
    "domain_denial": "propagate_without_oauth_retry"
  },
  "activation": "Candidate only. Consumption requires admission, full CI on the final revision and owner tests.",
  "sales_authority": {
    "operations": [
      "checkSalesAuthorization",
      "checkSalesTemporalAuthorization"
    ],
    "credential_scope": "private_per_sales_instance_profile_audience_and_configuration_generation",
    "check": "fresh_human_decision_per_invocation",
    "new_sale_post_human_checks": 6,
    "decision_budget_ms": 2000,
    "budget_anchor": "before_network_including_credential_wait",
    "reuse_requires_sufficient_call_budget": true,
    "unavailable": "valid_credential_only_and_fail_closed_without_current_decision",
    "instance_shutdown": "discard_entry_and_in_flight_generation",
    "sensitive_telemetry": false
  },
  "sale_preparation": {
    "context_workload_policy": "identity/http/shared/v2/identity-sale-preparation-workloads-v2.json",
    "scope": "technical_authentication_only_for_sale_preparation",
    "credential_and_acquisition_scope": "private_per_instance_profile_audience_and_configuration_generation",
    "instance_shutdown": "discard_entry_retire_in_flight_generation_and_discard_late_results",
    "gateway_issuance": "fresh_per_request",
    "human_delegation": "fresh_per_request",
    "human_decisions": "fresh_per_invocation",
    "callback_binding": "exact_caller_purpose_organization_operation_preparation_request_hash_and_owner_fingerprint",
    "preparation_maximum_seconds": 60,
    "decision_budget_ms": 2000,
    "decision_budget_anchor": "before_network_including_credential_wait"
  }
}
