{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/inventory/http/shared/v1/inventory-capture-authority-v1.schema.json",
  "title": "Inventory preparation verification for catalogue physical capture",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "operation_id",
        "preparation_id",
        "request_hash",
        "target"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
