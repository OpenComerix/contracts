{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/inventory/http/shared/v2/inventory-capture-authority-v2.schema.json",
  "title": "Inventory preparation verification v2; exact physical capture body binding",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "operation_id",
        "preparation_id",
        "request_hash",
        "target",
        "capture_fingerprint"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "preparation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "target": {
          "const": "catalog-pricing.inventory-capture",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "capture_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase SHA-256 of RFC 8785 JCS UTF-8 of the complete validated CaptureRequest sent to Catalog, including organization_id, operation_id, preparation_id, request_hash and ordered lines. No normalization, omitted fields or excluded hash fields. Different from the original human inventory-request-v1 request_hash. Catalog computes this value; Inventory compares it with its own preparation before rechecking the original human authority. Decision echoes it unchanged.",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "SECURITY",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "bound short-lived physical capture verification",
          "x-log-policy": "no payload, field values or raw digest; bounded diagnostic codes only",
          "x-retention-profile": "ephemeral_authority"
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "operation_id",
        "preparation_id",
        "request_hash",
        "authorized",
        "caller",
        "audience",
        "checked_at",
        "preparation_expires_at",
        "valid_for_ms",
        "capture_fingerprint"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "preparation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "authorized": {
          "const": true,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "caller": {
          "const": "catalog-pricing",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "audience": {
          "const": "inventory.catalog-capture-authority",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "preparation_expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "valid_for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "Owner operation, causal reconciliation and retained physical evidence",
          "x-log-policy": "no-payload-or-field-values; bounded diagnostic codes only",
          "x-retention-profile": "owner-policy; transport-does-not-authorize-storage"
        },
        "capture_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase SHA-256 of RFC 8785 JCS UTF-8 of the complete validated CaptureRequest sent to Catalog, including organization_id, operation_id, preparation_id, request_hash and ordered lines. No normalization, omitted fields or excluded hash fields. Different from the original human inventory-request-v1 request_hash. Catalog computes this value; Inventory compares it with its own preparation before rechecking the original human authority. Decision echoes it unchanged.",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "SECURITY",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "bound short-lived physical capture verification",
          "x-log-policy": "no payload, field values or raw digest; bounded diagnostic codes only",
          "x-retention-profile": "ephemeral_authority"
        }
      }
    }
  }
}
