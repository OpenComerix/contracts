{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_version": 2,
  "source_contract": "identity-onboarding-v2.yaml",
  "client_signal": {
    "version": 1,
    "parameter_ref": "#/components/parameters/OCClientSignal",
    "header": "X-OC-Client-Signal",
    "required_for_matrix_operations": true,
    "optional_on_infrastructure_operations": [
      "createGatewayUserDelegation",
      "recoverSessionRotationReplay"
    ],
    "value_pattern": "^v1\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
    "value_encoding": "v1. + canonical unpadded base64url(HMAC-SHA-256, 32 bytes)",
    "derivation": {
      "owner": "gateway-bff",
      "input": "verified_public_origin",
      "ipv4": "complete_address",
      "ipv6": "network_prefix_64",
      "mac": "HMAC-SHA-256",
      "domain_separation": true,
      "secret_minimum_bytes": 32,
      "secret_generation": "CSPRNG",
      "secret_exclusive_to": "gateway-bff"
    },
    "trust_boundary": {
      "browser_copy_removed_before_derivation": true,
      "ingress_must_be_explicitly_trusted": true,
      "implementation_phase": "PF1-06C",
      "identity_tenancy_authenticates_gateway_jwt_before_syntax_check": true,
      "identity_tenancy_verifies_hmac": false,
      "identity_tenancy_shares_hmac_secret": false,
      "accept_forwarded_headers_as_substitute": false,
      "transports_raw_ip_email_cookie_or_user_agent": false,
      "authority_granted": false
    },
    "failure": {
      "missing_duplicate_or_malformed": "identity_invalid_request",
      "status": 400,
      "generic": true,
      "fail_closed": true
    },
    "limits": {
      "purpose_scoped": true,
      "account": {"maximum": 10, "window_seconds": 900},
      "signal": {"maximum": 100, "window_seconds": 900},
      "windows_separate": true,
      "environment_configurable": true,
      "organization_configurable": false
    },
    "applies_to_operation_ids": [
      "registerGlobalAccount", "verifyEmail", "createSession", "completeMfaChallenge",
      "getCurrentSession", "logoutCurrentSession", "revokeOtherSessions",
      "beginTotpEnrollment", "confirmTotpEnrollment", "createDeviceRegistrationChallenge",
      "createRegisteredDeviceAuthenticationChallenge", "proveRegisteredDevicePossession",
      "registerWebDevice", "requestOwnerDeviceSelfApproval", "confirmOwnerDeviceSelfApproval",
      "createInitialOrganization", "listMyMemberships", "selectActiveOrganization",
      "getActiveTenantContext"
    ],
    "excluded_operation_ids": [
      "getEmailVerificationDeliveryMaterial",
      "getOwnerDeviceApprovalDeliveryMaterial"
    ],
    "fixtures": {
      "manifest": "openapi/client-signal-v1-fixtures.json",
      "schema": "openapi/client-signal-v1.schema.json",
      "runtime_hmac_or_ip_detection_demonstrated": false,
      "runtime_spoofing_resistance_demonstrated": false
    }
  },
  "service_only_operations": [
    {
      "method": "post",
      "path": "/identity/registrations",
      "operationId": "registerGlobalAccount"
    },
    {
      "method": "post",
      "path": "/identity/email-verifications",
      "operationId": "verifyEmail"
    },
    {
      "method": "post",
      "path": "/identity/sessions",
      "operationId": "createSession"
    },
    {
      "method": "post",
      "path": "/identity/mfa/challenges",
      "operationId": "completeMfaChallenge"
    }
  ],
  "delegated_operations": [
    {
      "method": "get",
      "path": "/identity/session",
      "operationId": "getCurrentSession"
    },
    {
      "method": "delete",
      "path": "/identity/session",
      "operationId": "logoutCurrentSession"
    },
    {
      "method": "post",
      "path": "/identity/session-revocations",
      "operationId": "revokeOtherSessions"
    },
    {
      "method": "post",
      "path": "/identity/mfa/totp-enrollments",
      "operationId": "beginTotpEnrollment"
    },
    {
      "method": "post",
      "path": "/identity/mfa/totp-enrollments/{enrollmentId}/confirmations",
      "operationId": "confirmTotpEnrollment"
    },
    {
      "method": "post",
      "path": "/identity/device-registration-challenges",
      "operationId": "createDeviceRegistrationChallenge"
    },
    {
      "method": "post",
      "path": "/identity/device-authentication-challenges",
      "operationId": "createRegisteredDeviceAuthenticationChallenge"
    },
    {
      "method": "post",
      "path": "/identity/device-authentications",
      "operationId": "proveRegisteredDevicePossession"
    },
    {
      "method": "post",
      "path": "/identity/devices",
      "operationId": "registerWebDevice"
    },
    {
      "method": "post",
      "path": "/identity/devices/{deviceId}/owner-approval-requests",
      "operationId": "requestOwnerDeviceSelfApproval"
    },
    {
      "method": "post",
      "path": "/identity/device-approval-confirmations",
      "operationId": "confirmOwnerDeviceSelfApproval"
    },
    {
      "method": "post",
      "path": "/tenancy/organization-onboardings",
      "operationId": "createInitialOrganization"
    },
    {
      "method": "get",
      "path": "/tenancy/memberships",
      "operationId": "listMyMemberships"
    },
    {
      "method": "post",
      "path": "/tenancy/context-selections",
      "operationId": "selectActiveOrganization"
    },
    {
      "method": "get",
      "path": "/tenancy/context",
      "operationId": "getActiveTenantContext"
    }
  ],
  "excluded_internal_operations": [
    {
      "method": "get",
      "path": "/internal/identity/email-verification-delivery-material/{deliveryMaterialId}",
      "operationId": "getEmailVerificationDeliveryMaterial"
    },
    {
      "method": "get",
      "path": "/internal/identity/device-approval-delivery-material/{deliveryMaterialId}",
      "operationId": "getOwnerDeviceApprovalDeliveryMaterial"
    }
  ],
  "published_examples": [
    {
      "status": "200",
      "name": "restricted_session",
      "fixture": "examples/identity-gateway-delegation-v2-delegation-response-restricted.json",
      "context_fixture": "examples/identity-gateway-delegation-v2-delegation-context-restricted.json"
    },
    {
      "status": "200",
      "name": "tenant_session",
      "fixture": "examples/identity-gateway-delegation-v2-delegation-response-tenant.json",
      "context_fixture": "examples/identity-gateway-delegation-v2-delegation-context-tenant.json"
    },
    {
      "status": "401",
      "name": "invalid_or_missing_identity",
      "fixture": "examples/identity-gateway-delegation-v2-problem-unauthorized.json"
    },
    {
      "status": "403",
      "name": "delegation_not_allowed",
      "fixture": "examples/identity-gateway-delegation-v2-problem-forbidden.json"
    }
  ],
  "context_fixtures": [
    "examples/identity-gateway-delegation-v2-delegation-context-restricted.json",
    "examples/identity-gateway-delegation-v2-delegation-context-tenant.json",
    "examples/identity-gateway-delegation-v2-delegation-context-restricted-with-device.json",
    "examples/identity-gateway-delegation-v2-delegation-context-active-no-tenant.json"
  ],
  "negative_context_fixtures": [
    "examples/identity-gateway-delegation-v2-negative-active-no-tenant-device-unbound.json",
    "examples/identity-gateway-delegation-v2-negative-audience.json",
    "examples/identity-gateway-delegation-v2-negative-claim-names.json",
    "examples/identity-gateway-delegation-v2-negative-claim-types.json",
    "examples/identity-gateway-delegation-v2-negative-issuer-invalid.json",
    "examples/identity-gateway-delegation-v2-negative-issuer-mismatch.json",
    "examples/identity-gateway-delegation-v2-negative-jti-invalid.json",
    "examples/identity-gateway-delegation-v2-negative-restricted-device-unbound.json",
    "examples/identity-gateway-delegation-v2-negative-restricted-tenant-claims.json",
    "examples/identity-gateway-delegation-v2-negative-session-mismatch.json",
    "examples/identity-gateway-delegation-v2-negative-session-missing.json",
    "examples/identity-gateway-delegation-v2-negative-tenant-branch-mismatch.json",
    "examples/identity-gateway-delegation-v2-negative-tenant-branch-unverified.json",
    "examples/identity-gateway-delegation-v2-negative-tenant-device-mismatch.json",
    "examples/identity-gateway-delegation-v2-negative-tenant-device-missing.json",
    "examples/identity-gateway-delegation-v2-negative-tenant-device-unapproved.json",
    "examples/identity-gateway-delegation-v2-negative-type.json"
  ]
}
