{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/catalog/http/shared/v1/catalog-prices-v1.schema.json",
  "title": "Catalog prices v1 — F1-07D candidate",
  "description": "Transport only. One organization default list ARS tax included. Server-owned IDs and UTC instants. Positive decimal strings; sequence version per organization/presentation/default list. Prospective intervals [valid_from, valid_to), never rewrite prior amount/version. Replay captured result even if persisted interval subsequently closes. Runtime/SQL and final admission pending.",
  "$defs": {
    "PriceList": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "price_list_id",
        "organization_id",
        "currency",
        "tax_included",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "price_list_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "organization_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/IdentityReference"
        },
        "currency": {
          "const": "ARS"
        },
        "tax_included": {
          "const": true
        },
        "version": {
          "$ref": "catalog-common-v1.schema.json#/$defs/AggregateVersion"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        }
      }
    },
    "Price": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "price_id",
        "organization_id",
        "price_list_id",
        "product_id",
        "presentation_id",
        "amount",
        "currency",
        "tax_included",
        "version",
        "valid_from",
        "valid_to"
      ],
      "properties": {
        "price_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "organization_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/IdentityReference"
        },
        "price_list_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "product_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "presentation_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "amount": {
          "$ref": "catalog-common-v1.schema.json#/$defs/PriceDecimal"
        },
        "currency": {
          "const": "ARS"
        },
        "tax_included": {
          "const": true
        },
        "version": {
          "$ref": "catalog-common-v1.schema.json#/$defs/AggregateVersion"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PricesPage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items", "page"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Price"
          }
        },
        "page": {
          "$ref": "catalog-common-v1.schema.json#/$defs/Page"
        }
      }
    },
    "PriceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "expected_version"],
      "properties": {
        "amount": {
          "$ref": "catalog-common-v1.schema.json#/$defs/PriceDecimal"
        },
        "expected_version": {
          "$ref": "catalog-common-v1.schema.json#/$defs/PriceExpectedVersion"
        }
      }
    }
  }
}
