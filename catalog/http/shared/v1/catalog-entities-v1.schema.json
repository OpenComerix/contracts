    "Presentation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "presentation_id",
        "product_id",
        "variant_id",
        "organization_id",
        "version",
        "created_at",
        "updated_at",
        "name",
        "unit_code",
        "conversion_factor",
        "allows_fractions",
        "minimum_quantity",
        "quantity_increment",
        "status"
      ],
      "properties": {
        "presentation_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "product_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "variant_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "organization_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/IdentityReference"
        },
        "version": {
          "$ref": "catalog-common-v1.schema.json#/$defs/AggregateVersion"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "name": {
          "$ref": "#/$defs/Name80"
        },
        "unit_code": {
          "$ref": "catalog-common-v1.schema.json#/$defs/UnitCode"
        },
        "conversion_factor": {
          "$ref": "catalog-common-v1.schema.json#/$defs/ConversionFactor"
        },
        "allows_fractions": {
          "type": "boolean"
        },
        "minimum_quantity": {
          "$ref": "#/$defs/PositiveQuantity"
        },
        "quantity_increment": {
          "$ref": "#/$defs/PositiveQuantity"
        },
        "status": {
          "$ref": "#/$defs/State"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allows_fractions": {
                "const": false
              }
            },
            "required": ["allows_fractions"]
          },
          "then": {
            "properties": {
              "minimum_quantity": {
                "pattern": "^[1-9][0-9]{0,11}$"
              },
              "quantity_increment": {
                "pattern": "^[1-9][0-9]{0,11}$"
              }
            }
          }
        }
      ]
    },
    "Barcode": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "barcode_id",
        "presentation_id",
        "organization_id",
        "type",
        "value",
        "status",
        "created_at",
        "retired_at"
      ],
      "properties": {
        "barcode_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "presentation_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        },
        "organization_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/IdentityReference"
        },
        "type": {
          "type": "string",
          "enum": ["GTIN_8", "GTIN_12", "GTIN_13", "GTIN_14", "INTERNAL"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["active", "retired"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "retired_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "GTIN_8"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]{8}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "GTIN_12"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "GTIN_13"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]{13}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "GTIN_14"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]{14}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "INTERNAL"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^OC:[A-Z0-9_.-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "retired_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "retired_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        }
      ]
    },
    "PresentationWithBarcodes": {
      "type": "object",
      "additionalProperties": true,
      "required": ["presentation", "barcodes"],
      "properties": {
        "presentation": {
          "$ref": "#/$defs/Presentation"
