    "ProductsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
        },
        "cursor": {
          "$ref": "catalog-common-v1.schema.json#/$defs/Cursor"
        },
        "q": {
          "$ref": "#/$defs/Name160"
        },
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "plu": {
          "$ref": "#/$defs/Plu"
        },
        "barcode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "$ref": "#/$defs/State"
        },
        "category_id": {
          "$ref": "catalog-common-v1.schema.json#/$defs/CatalogId"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["sku"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["q"]
                },
                {
                  "required": ["plu"]
                },
                {
                  "required": ["barcode"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["plu"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["q"]
                },
                {
                  "required": ["sku"]
                },
                {
                  "required": ["barcode"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["barcode"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["q"]
                },
                {
                  "required": ["sku"]
                },
                {
                  "required": ["plu"]
                }
              ]
            }
          }
        }
      ]
