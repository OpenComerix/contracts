{
  "protocol_version": 1,
  "status": "candidate",
  "owner": "catalog-pricing",
  "runtime_demonstrated": false,
  "production_enabled": false,
  "transport": {
    "caller": "catalog-pricing",
    "audience": "catalog-pricing.history-recovery",
    "authentication": "H1A ES256 plus fresh R3 authority via identity verification v2 for every request; no new reader is enabled",
    "request_bytes": 131072,
    "response_bytes": 1048576,
    "event_bytes": 131072,
    "deadline_ms": 10000
  },
  "limits": {
    "session_absolute_ms": 3600000,
    "grant_maximum_ms": 900000,
    "metadata_after_original_close_or_expiry_ms": 86400000,
    "events_default": 100,
    "events_maximum": 500,
    "coverage_ranges_per_page": 500,
    "pages_in_flight_per_session": 1,
    "active_sessions_per_tenant": 2,
    "page_requests_per_second_per_tenant": 5,
    "total_history_quota": null,
    "plan_dependent": false
  },
  "cursor": {
    "version": 1,
    "format": "ocrc1_ + canonical-unpadded-base64url(CSPRNG(32 bytes))",
    "storage": "SHA-256(UTF-8 token) only; no plaintext token/grant or event cache",
    "keys": "no cursor signing/encryption keys; H1A key management remains independent",
    "bindings": [
      "recovery_id",
      "organization_id",
      "workload",
      "binding_hash",
      "cut_position",
      "after_position",
      "expires_at",
      "version"
    ],
    "retries": "previous handles remain valid until unchanged session expiry; new next/initial handles may differ"
  },
  "semantics": {
    "creation": "UUIDv7 timestamp inside [issued_at from fresh trusted identity v2 VerifyResponse, server now] only when session absent; atomically admit same intent and tenant slots; existing session checks original immutable binding/after/cut/times without timestamp renewal",
    "selection": "exact R3 binding; arrays preserve order; empty IDs/versions match all; aggregate versions do not redefine published event revisions",
    "positions": "canonical decimal strings; BigInt comparisons; confirmed contiguous per-tenant order; no reserved-sequence or timestamp watermark",
    "coverage": "global requested status and scanned partition from same source view; filters are not gaps; missing original-selection evidence means conservative partial, never complete",
    "retries": "fresh authority plus live source/coverage; never cached event payloads; completion frees slot and only terminal-after/limit may replay before absolute expiry; a closed-session terminal replay that cannot reach the fixed cut within current budgets returns catalog_recovery_closed without a next cursor; require a new authorized intention",
    "disposition": "no pin, synthetic original or resurrection; no unknown-gap inference as legitimate disposal",
    "authority": "R3 session_id is person session, separate from recovery_id; only catalog-pricing reader; no inference for OWNER/H2/header or other workload"
  },
