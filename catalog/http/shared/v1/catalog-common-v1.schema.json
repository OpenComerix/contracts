{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/catalog/http/shared/v1/catalog-common-v1.schema.json",
  "title": "catalog-common-v1",
  "$defs": {
    "CatalogId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "DelegationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "IdentityReference": {
      "type": "string",
      "minLength": 1,
      "description": "Referencia opaca de identidad: no imponer UUIDv7 ni reinterpretar versiones."
    },
    "IdentityVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Versión opaca de identidad conservada como cadena."
    },
    "AggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ExpectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "PriceExpectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PriceDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,2})?$",
      "not": {
        "pattern": "^0(?:\\.0+)?$"
      },
      "description": "Precio ARS positivo, hasta 12 dígitos enteros y dos decimales; sin redondeo."
    },
    "QuantityDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,3})?$"
    },
    "IndivisibleQuantity": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})$"
    },
    "ConversionFactor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$",
      "not": {
        "pattern": "^0(?:\\.0+)?$"
      }
    },
    "UnitCode": {
      "enum": [
        "unit",
        "kg",
        "g",
        "l",
        "ml",
        "m",
        "cm",
        "m2"
      ]
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Opaco, máximo 30 minutos, vinculado al contexto/filtros; no concede autoridad."
    },
    "PageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "Page": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "next_cursor",
        "has_more",
        "limit"
      ],
      "properties": {
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "limit": {
          "$ref": "#/$defs/PageLimit"
        }
      }
    },
    "IdempotencyKey": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "CacheControl": {
      "type": "string",
      "const": "no-store"
    },
    "IdempotencyReplayed": {
      "type": "boolean"
    },
    "ETag": {
      "type": "string",
      "pattern": "^\"[^\"\\x00-\\x20\\x7f]+\"$",
      "description": "ETag opaco de representación completa, no precondición adicional."
    },
    "Location": {
      "type": "string",
      "pattern": "^/api/v1/(?:catalog|pricing)/[^?#]+$"
    },
    "RetryAfter": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "ClientSignal": {
      "type": "string",
      "pattern": "^v1\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "CanonicalizationVersion": {
      "const": "catalog-request-v1"
    },
    "Permission": {
      "enum": [
        "catalog.read",
        "catalog.manage",
        "pricing.read",
        "pricing.manage"
      ]
    }
  }
}
