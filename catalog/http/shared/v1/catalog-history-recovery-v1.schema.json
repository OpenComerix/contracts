{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/catalog/http/shared/v1/catalog-history-recovery-v1.schema.json",
  "title": "Catalog history recovery selection v1 — candidate",
  "description": "Selection and destination shared by the R3 authority contract and the future R4 recovery surface. It grants no authority by itself.",
  "$defs": {
    "AggregateType": {
      "type": "string",
      "enum": ["category", "product", "presentation", "presentation_price"]
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_types", "aggregate_ids", "versions"],
      "properties": {
        "aggregate_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AggregateType" }
        },
        "aggregate_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "versions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" }
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workload", "audience"],
      "properties": {
        "kind": { "const": "catalog-pricing-recovery" },
        "workload": { "const": "catalog-pricing" },
        "audience": { "const": "identity-tenancy.catalog-recovery" }
      }
    },
    "Purpose": {
      "type": "string",
      "enum": ["exceptional-history-recovery", "restricted-history-configuration"]
    }
  }
}
