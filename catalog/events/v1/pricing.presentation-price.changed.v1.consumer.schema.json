{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/catalog/events/v1/pricing.presentation-price.changed.v1.consumer.schema.json",
  "title": "pricing.presentation-price.changed.v1 consumer profile revision 1 candidate",
  "description": "Consumer validates known fields and the immutable envelope. Optional payload extensions are admitted only by explicit compatibility declaration; the initial profile has none. Synthetic evolution fixtures exercise older/newer readers without admitting revision 2.",
  "allOf": [
    {
      "$ref": "../../../events/event-envelope-v1.schema.json"
    },
    {
      "type": "object",
      "required": [
        "causation_id"
      ],
      "properties": {
        "event_type": {
          "const": "pricing.presentation-price.changed.v1"
        },
        "schema_version": {
          "const": 1
        },
        "producer": {
          "const": "catalog-pricing"
        },
        "aggregate_type": {
          "const": "presentation_price"
        },
        "event_id": {
          "$ref": "catalog-event-data-v1.schema.json#/$defs/C_CatalogId"
        },
        "aggregate_id": {
          "$ref": "catalog-event-data-v1.schema.json#/$defs/C_CatalogId"
        },
        "aggregate_version": {
          "$ref": "catalog-event-data-v1.schema.json#/$defs/C_AggregateVersion"
        },
        "causation_id": {
          "$ref": "catalog-event-data-v1.schema.json#/$defs/C_CatalogId"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "branch_id": false,
        "pos_id": false,
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "list",
            "price",
            "previous_price"
          ],
          "properties": {
            "operation_id": {
              "const": "createPresentationPrice"
            },
            "list": {
              "$ref": "catalog-event-data-v1.schema.json#/$defs/P_PriceList"
            },
            "price": {
              "$ref": "catalog-event-data-v1.schema.json#/$defs/P_Price"
            },
            "previous_price": {
              "anyOf": [
                {
                  "$ref": "catalog-event-data-v1.schema.json#/$defs/P_Price"
                },
                {
                  "type": "null"
                }
              ]
            },
            "extensions": {
              "type": "object",
              "maxProperties": 0,
              "additionalProperties": false
            }
          }
        }
      }
    }
  ],
  "x-data-classification": {
    "sensitivity": "RESTRICTED",
    "categories": [
      "COMMERCIAL",
      "FISCAL"
    ]
  },
  "x-data-purpose": "Retained catalog/price meaning; per-field classification in catalog-event-policy-v1.json",
  "x-retention-profile": "TECHNICAL_SHORT (serialized transport only; owner historical policy required before F1-08)",
  "x-log-policy": "no-event-body-or-field-values"
}
