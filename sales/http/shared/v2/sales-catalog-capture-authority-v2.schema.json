{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/sales/http/shared/v2/sales-catalog-capture-authority-v2.schema.json",
  "title": "Sales ephemeral preparation callback v2; no durable human credentials",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "operation_id",
        "preparation_id",
        "request_hash",
        "capture_fingerprint"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "FISCAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "immutable operation and future authorized reconstruction",
          "x-log-policy": "no payload or field values, bounded codes only",
          "x-retention-profile": "commercial"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "COMMERCIAL",
              "FISCAL",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "immutable operation and future authorized reconstruction",
