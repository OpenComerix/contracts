          "x-retention-profile": "commercial"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "x-data-classification": {
            "sensitivity": "RESTRICTED",
            "categories": [
              "SECURITY",
              "OPERATIONAL"
            ]
          },
          "x-data-purpose": "bound short-lived request verification",
          "x-log-policy": "no values or raw digest",
          "x-retention-profile": "ephemeral_authority"
        },
        "capture_fingerprint": {
