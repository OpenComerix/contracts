{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/sales/http/shared/v2/sales-lifecycle-policy-v2.schema.json",
  "title": "Sales field and storage classifications v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "owner",
    "status",
    "runtime_demonstrated",
    "production_enabled",
    "sources",
    "profiles",
    "transport_fields",
    "storage_policies",
    "holds"
  ],
  "properties": {
    "policy_version": {
      "const": 2
    },
    "owner": {
      "const": "sales-pos"
    },
    "status": {
      "const": "candidate"
    },
    "runtime_demonstrated": {
      "const": false
    },
    "production_enabled": {
      "const": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensitivity",
          "categories",
          "purpose",
          "access",
          "log_policy",
          "persistence"
        ],
        "properties": {
          "sensitivity": {
            "const": "RESTRICTED"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "log_policy": {
            "type": "string",
            "minLength": 1
          },
          "persistence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transport_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "pointer",
          "profile"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "profile": {
            "enum": [
              "commercial",
              "restricted_authority",
              "ephemeral_authority",
              "fiscal_identity"
            ]
          }
        }
      }
    },
    "storage_policies": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "storage",
          "category",
          "retention",
          "clock",
          "bounds",
          "guards",
          "production_enabled"
        ],
        "properties": {
          "storage": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          },
          "clock": {
            "type": "string",
            "minLength": 1
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "default",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "type": "string",
                "minLength": 1
              },
              "default": {
                "type": "string",
                "minLength": 1
              },
              "maximum": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "guards": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "production_enabled": {
            "const": false
          }
        }
      }
    },
    "holds": {
      "type": "string",
      "minLength": 1
    }
  }
}
