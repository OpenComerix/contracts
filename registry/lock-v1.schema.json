{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "service",
    "manifestSha256",
    "entries",
    "assets"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "manifestSha256": {
      "$ref": "#/$defs/hash"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/registry/lock-v1.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "version",
        "sourceRepository",
        "commit",
        "tag",
        "tagObject",
        "root",
        "operations",
        "pointers",
        "files",
        "units",
        "selectionSha256",
        "runtimeSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceRepository": {
          "const": "opencomerix/contracts"
        },
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "tagObject": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "pointer",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "selectionSha256": {
          "$ref": "#/$defs/hash"
        },
        "runtimeSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "sourcePath",
        "destination",
        "representation",
        "purpose",
        "sourceSha256",
        "semanticSha256",
        "localSha256"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": [
            "exact",
            "json-format"
          ]
        },
        "purpose": {
          "enum": [
            "runtime",
            "validation",
            "documentation"
          ]
        },
        "sourceSha256": {
          "$ref": "#/$defs/hash"
        },
        "semanticSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "localSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
