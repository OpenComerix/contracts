{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/sales.sale.reversed.v1.schema.json",
  "title": "sales.sale.reversed.v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "sales.sale.reversed.v1" },
        "schema_version": { "const": 1 },
        "producer": { "const": "sales-pos" },
        "aggregate_type": { "const": "sale" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sale_id", "reversal_id", "reversal_type", "reason_code", "user_id", "occurred_at", "amount", "lines"],
          "properties": {
            "sale_id": { "type": "string", "format": "uuid" },
            "reversal_id": { "type": "string", "format": "uuid" },
            "reversal_type": { "type": "string", "enum": ["cancellation", "return"] },
            "reason_code": { "type": "string", "minLength": 1 },
            "reason_detail": { "type": ["string", "null"] },
            "user_id": { "type": "string", "format": "uuid" },
            "supervisor_user_id": { "type": ["string", "null"], "format": "uuid" },
            "occurred_at": { "type": "string", "format": "date-time" },
            "amount": { "$ref": "sale-flow-common-v1.schema.json#/$defs/decimal" },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "sale-flow-common-v1.schema.json#/$defs/saleLineQuantity" }
            }
          }
        }
      }
    }
  ]
}
