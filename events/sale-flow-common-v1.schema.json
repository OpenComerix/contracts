{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/sale-flow-common-v1.schema.json",
  "title": "Tipos comunes del flujo de venta v1",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "saleLineQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "product_id", "presentation_id", "quantity"],
      "properties": {
        "line_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string", "format": "uuid" },
        "presentation_id": { "type": "string", "format": "uuid" },
        "quantity": { "$ref": "#/$defs/decimal" },
        "lot_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_id", "method", "amount"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "method": {
          "type": "string",
          "enum": ["cash", "card", "transfer", "check", "customer_account", "other"]
        },
        "amount": { "$ref": "#/$defs/decimal" },
        "external_reference": { "type": ["string", "null"] }
      }
    }
  }
}
