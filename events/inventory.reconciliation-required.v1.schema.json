{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/inventory.reconciliation-required.v1.schema.json",
  "title": "inventory.reconciliation-required.v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "inventory.reconciliation-required.v1" },
        "schema_version": { "const": 1 },
        "producer": { "const": "inventory" },
        "aggregate_type": { "const": "inventory_reconciliation" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reconciliation_id", "source_type", "source_id", "warehouse_id", "reason_code", "severity", "detected_at", "differences"],
          "properties": {
            "reconciliation_id": { "type": "string", "format": "uuid" },
            "source_type": { "type": "string", "enum": ["sale", "return", "count", "transfer", "adjustment"] },
            "source_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "reason_code": { "type": "string", "minLength": 1 },
            "severity": { "type": "string", "enum": ["warning", "critical"] },
            "detected_at": { "type": "string", "format": "date-time" },
            "differences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product_id", "expected_quantity", "resulting_quantity"],
                "properties": {
                  "product_id": { "type": "string", "format": "uuid" },
                  "lot_id": { "type": ["string", "null"], "format": "uuid" },
                  "expected_quantity": { "$ref": "sale-flow-common-v1.schema.json#/$defs/decimal" },
                  "resulting_quantity": { "$ref": "sale-flow-common-v1.schema.json#/$defs/decimal" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
