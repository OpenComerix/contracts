{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/fiscal.document.authorized.v1.schema.json",
  "title": "fiscal.document.authorized.v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "fiscal.document.authorized.v1" },
        "schema_version": { "const": 1 },
        "producer": { "const": "fiscal-arca" },
        "aggregate_type": { "const": "fiscal_document" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_id", "sale_id", "authorization_type", "authorization_code", "document_type", "document_class", "fiscal_pos", "number", "issued_at", "currency", "total"],
          "properties": {
            "document_id": { "type": "string", "format": "uuid" },
            "sale_id": { "type": "string", "format": "uuid" },
            "authorization_type": { "type": "string", "enum": ["cae", "caea"] },
            "authorization_code": { "type": "string", "minLength": 1 },
            "authorization_expires_at": { "type": ["string", "null"], "format": "date" },
            "document_type": { "type": "string", "enum": ["invoice", "credit_note", "debit_note"] },
            "document_class": { "type": "string", "enum": ["A", "B", "C"] },
            "fiscal_pos": { "type": "integer", "minimum": 1 },
            "number": { "type": "integer", "minimum": 1 },
            "issued_at": { "type": "string", "format": "date-time" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "total": { "$ref": "sale-flow-common-v1.schema.json#/$defs/decimal" },
            "arca_observations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  ]
}
