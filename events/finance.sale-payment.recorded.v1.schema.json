{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/finance.sale-payment.recorded.v1.schema.json",
  "title": "finance.sale-payment.recorded.v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "finance.sale-payment.recorded.v1" },
        "schema_version": { "const": 1 },
        "producer": { "const": "finance" },
        "aggregate_type": { "const": "sale_payment" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sale_id", "cash_shift_id", "currency", "total", "recorded_at", "payments"],
          "properties": {
            "sale_id": { "type": "string", "format": "uuid" },
            "cash_shift_id": { "type": "string", "format": "uuid" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "total": { "$ref": "sale-flow-common-v1.schema.json#/$defs/decimal" },
            "recorded_at": { "type": "string", "format": "date-time" },
            "payments": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "sale-flow-common-v1.schema.json#/$defs/payment" }
            }
          }
        }
      }
    }
  ]
}
