{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/events/fiscal.document.rejected.v1.schema.json",
  "title": "fiscal.document.rejected.v1",
  "allOf": [
    { "$ref": "event-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "fiscal.document.rejected.v1" },
        "schema_version": { "const": 1 },
        "producer": { "const": "fiscal-arca" },
        "aggregate_type": { "const": "fiscal_document" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_id", "sale_id", "rejected_at", "retryable", "errors"],
          "properties": {
            "attempt_id": { "type": "string", "format": "uuid" },
            "document_id": { "type": ["string", "null"], "format": "uuid" },
            "sale_id": { "type": "string", "format": "uuid" },
            "rejected_at": { "type": "string", "format": "date-time" },
            "retryable": { "type": "boolean" },
            "errors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": { "type": "string" },
                  "message": { "type": "string" },
                  "source": { "type": "string", "enum": ["arca", "validation", "transport", "configuration"] }
                }
              }
            }
          }
        }
      }
    }
  ]
}
