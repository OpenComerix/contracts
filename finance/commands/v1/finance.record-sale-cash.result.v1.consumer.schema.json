{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/finance/commands/v1/finance.record-sale-cash.result.v1.consumer.schema.json",
  "title": "finance.record-sale-cash.result.v1",
  "allOf": [
    {
      "$ref": "../../../commands/command-result-envelope-v1.schema.json"
    },
    {
      "properties": {
        "result_type": {
          "const": "finance.record-sale-cash.result.v1"
        },
        "schema_version": {
          "const": 1
        },
        "producer": {
          "const": "finance"
        },
        "result_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "retryable": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "../../http/shared/v1/finance-consumer-types-v1.schema.json#/$defs/Payment"
              }
            }
          },
          "else": {
            "properties": {
              "error_code": {
                "enum": [
                  "finance_cash_shift_required",
                  "finance_cash_shift_not_open",
                  "finance_version_conflict",
                  "finance_state_conflict",
                  "finance_operation_conflict",
                  "finance_cash_amount_invalid",
                  "finance_currency_unsupported",
                  "finance_resource_not_found"
                ]
              },
              "payload": {
                "$ref": "../../http/shared/v1/finance-consumer-types-v1.schema.json#/$defs/FailedCash"
              }
            }
          }
        }
      ]
    }
  ]
}
