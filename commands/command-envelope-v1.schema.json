{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opencomerix.example/commands/command-envelope-v1.schema.json",
  "title": "OpenComerix directed command envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "command_type", "schema_version", "requested_at", "producer", "target", "correlation_id", "payload"],
  "properties": {
    "command_id": { "type": "string", "format": "uuid" },
    "command_type": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "requested_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" },
    "organization_id": { "type": ["string", "null"], "format": "uuid" },
    "payload": { "type": "object" }
  }
}
